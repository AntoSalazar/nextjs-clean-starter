# ===========================================
# Next.js Clean Architecture Starter Kit
# Environment Configuration
# ===========================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Starter Kit"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_kit?schema=public

# JWT Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# API Key Configuration
API_KEY_PREFIX=sk_

# Email (Resend) - Optional
# Leave empty to disable email features
RESEND_API_KEY=
EMAIL_FROM="Starter Kit <noreply@yourdomain.com>"

# Admin Seed Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME="Super Admin"

# Docker Development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=starter_kit
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
